      - family-names: "Zhong"
        given-names: "Shaochen"
      - family-names: "Chaudhary"
        given-names: "Vipin"
      - family-names: "Sui"
        given-names: "Yang"
      - family-names: "Hu"
        given-names: "Xia"
      - family-names: "Shrivastava"
        given-names: "Anshumali"
    collection-title: "The Thirty-ninth Annual Conference on Neural Information Processing Systems"
    year: 2025
    url: "https://openreview.net/forum?id=xdNAVP7TGy"
